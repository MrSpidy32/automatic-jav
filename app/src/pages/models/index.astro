---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Models & Actresses Directory · JAV.guru" currentPage="models" activeSource="Models Directory" itemCount="Dynamic">
  <div class="space-y-6">

    <!-- Top Header -->
    <div class="border-b border-[var(--border-rule)] pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-4 font-mono">
      <div>
        <div class="text-xs text-[var(--accent-cyan)] mb-1">PERSONNEL // DIRECTORY</div>
        <h1 class="font-display text-2xl font-bold text-[var(--text-bright)]">Models & Actresses Gallery</h1>
        <p class="text-xs text-[var(--text-dim)] mt-1">Consolidated directory of model profiles from JavCT and OneJAV archives.</p>
      </div>
      <div id="models-total-badge" class="text-xs text-[var(--text-dim)]">
        Loading directory...
      </div>
    </div>

    <!-- Search Controls -->
    <div class="bg-[var(--bg-panel)] border border-[var(--border-rule)] p-4 rounded-lg flex flex-col sm:flex-row items-center justify-between gap-3 font-mono text-xs">
      <div class="relative flex-1 w-full">
        <input
          type="search"
          id="model-search"
          placeholder="Filter by model name..."
          class="w-full bg-[var(--bg-shell)] border border-[var(--border-rule)] focus:border-[var(--accent-cyan)] px-3 py-2 rounded text-[var(--text-bright)] placeholder:text-[var(--text-muted)] focus:outline-none"
          autocomplete="off"
        />
      </div>
      <div class="flex items-center gap-2">
        <button id="filter-all" type="button" class="px-2.5 py-1.5 rounded bg-[var(--accent-cyan)] text-black font-semibold cursor-pointer border-0">All</button>
        <button id="filter-javct" type="button" class="px-2.5 py-1.5 rounded bg-[var(--bg-shell)] hover:bg-[var(--bg-panel-hover)] text-[var(--text-dim)] border border-[var(--border-rule)] cursor-pointer">With Photos (JavCT)</button>
      </div>
    </div>

    <!-- Models Grid -->
    <div id="models-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 font-mono text-xs">
      <div class="col-span-full text-center py-12 text-[var(--text-muted)]">
        Hydrating models directory...
      </div>
    </div>

    <div id="models-pagination" class="flex items-center justify-center gap-3 pt-6 border-t border-[var(--border-rule)] font-mono text-xs text-[var(--text-dim)]">
      <button id="models-prev" class="px-3 py-1.5 rounded bg-[var(--bg-panel)] border border-[var(--border-rule)] disabled:opacity-40 cursor-pointer" disabled>Prev</button>
      <span id="models-page-text">Page 1</span>
      <button id="models-next" class="px-3 py-1.5 rounded bg-[var(--bg-panel)] border border-[var(--border-rule)] disabled:opacity-40 cursor-pointer" disabled>Next</button>
    </div>

  </div>

  <script is:inline>
    (function() {
      // Resolve feeds relative to the current page so both the repository root
      // test server and the GitHub Pages /automatic-jav/ base path work.
      const BASE_URL = new URL('../', window.location.href).href;
      const ITEMS_PER_PAGE = 36;

      let MODELS = [];
      let FILTERED = [];
      let PAGE = 1;
      let FILTER_SOURCE = 'all';

      const grid = document.getElementById('models-grid');
      const search = document.getElementById('model-search');
      const totalBadge = document.getElementById('models-total-badge');
      const prevBtn = document.getElementById('models-prev');
      const nextBtn = document.getElementById('models-next');
      const pageText = document.getElementById('models-page-text');

      const btnAll = document.getElementById('filter-all');
      const btnJavct = document.getElementById('filter-javct');

      async function init() {
        try {
          const res = await fetch(`${BASE_URL}models.json`);
          MODELS = await res.json();
          FILTERED = MODELS;
          totalBadge.textContent = `${MODELS.length.toLocaleString()} total profiles`;
          render();
        } catch (e) {
          const err = document.createElement('div');
          err.className = 'col-span-full text-center text-xs text-[var(--accent-amber)]';
          err.textContent = 'Failed to load models.json feed.';
          grid.replaceChildren(err);
        }
      }

      function applyFilter() {
        const q = search.value.trim().toLowerCase();
        FILTERED = MODELS.filter(m => {
          if (FILTER_SOURCE === 'javct' && (!m.image_url || m.source !== 'JavCT')) return false;
          if (q && !m.name.toLowerCase().includes(q)) return false;
          return true;
        });
        PAGE = 1;
        render();
      }

      function render() {
        const totalPages = Math.max(1, Math.ceil(FILTERED.length / ITEMS_PER_PAGE));
        if (PAGE > totalPages) PAGE = totalPages;
        if (PAGE < 1) PAGE = 1;

        const start = (PAGE - 1) * ITEMS_PER_PAGE;
        const slice = FILTERED.slice(start, start + ITEMS_PER_PAGE);

        pageText.textContent = `Page ${PAGE} / ${totalPages} (${FILTERED.length.toLocaleString()} results)`;
        prevBtn.disabled = PAGE <= 1;
        nextBtn.disabled = PAGE >= totalPages;

        function safeUrl(raw) {
          if (!raw || typeof raw !== 'string') return '';
          const trimmed = raw.trim();
          if (trimmed.startsWith('https://') || trimmed.startsWith('http://') || trimmed.startsWith('/')) {
            return trimmed;
          }
          return '';
        }

        grid.replaceChildren();
        if (slice.length === 0) {
          const empty = document.createElement('div');
          empty.className = 'col-span-full text-center py-12 text-[var(--text-muted)]';
          empty.textContent = 'No models match your search criteria.';
          grid.appendChild(empty);
          return;
        }

        const frag = document.createDocumentFragment();
        slice.forEach(m => {
          const card = document.createElement('a');
          card.className = 'group bg-[var(--bg-panel)] hover:bg-[var(--bg-panel-hover)] border border-[var(--border-rule)] hover:border-[var(--accent-cyan)] rounded-lg overflow-hidden flex flex-col no-underline text-inherit transition-all';
          card.href = safeUrl(m.page_url) || '#';
          card.target = '_blank';
          card.rel = 'noopener';

          const thumb = document.createElement('div');
          thumb.className = 'aspect-square bg-black/40 overflow-hidden relative flex items-center justify-center text-[var(--text-muted)]';

          const fallback = document.createElement('span');
          fallback.className = 'font-bold text-lg text-[var(--text-muted)]';
          fallback.textContent = (m.name || '?').charAt(0).toUpperCase();

          const safeImg = safeUrl(m.image_url);
          if (safeImg) {
            const img = document.createElement('img');
            img.src = safeImg;
            img.alt = m.name || 'Model';
            img.loading = 'lazy';
            img.className = 'w-full h-full object-cover group-hover:scale-105 transition-transform duration-300';
            img.onerror = () => {
              thumb.replaceChildren(fallback);
            };
            thumb.appendChild(img);
          } else {
            thumb.appendChild(fallback);
          }

          if (m.views) {
            const vBadge = document.createElement('span');
            vBadge.className = 'absolute top-1.5 right-1.5 px-1.5 py-0.5 rounded bg-black/75 text-[10px] text-[var(--accent-cyan)]';
            vBadge.textContent = `👁 ${m.views}`;
            thumb.appendChild(vBadge);
          }

          const info = document.createElement('div');
          info.className = 'p-3 flex flex-col justify-between flex-1';

          const name = document.createElement('span');
          name.className = 'font-bold text-[var(--text-bright)] group-hover:text-[var(--accent-cyan)] truncate';
          name.textContent = m.name || '';

          const source = document.createElement('div');
          source.className = 'text-[10px] text-[var(--text-muted)] mt-1 flex items-center justify-between';
          const srcName = document.createElement('span');
          srcName.textContent = m.source || '';
          const arrow = document.createElement('span');
          arrow.className = 'text-[var(--accent-cyan)]';
          arrow.textContent = '↗';
          source.appendChild(srcName);
          source.appendChild(arrow);

          info.appendChild(name);
          info.appendChild(source);

          card.appendChild(thumb);
          card.appendChild(info);
          frag.appendChild(card);
        });
        grid.appendChild(frag);
      }

      let timer;
      search.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(applyFilter, 150);
      });

      btnAll.onclick = () => {
        FILTER_SOURCE = 'all';
        btnAll.className = 'px-2.5 py-1.5 rounded bg-[var(--accent-cyan)] text-black font-semibold cursor-pointer border-0';
        btnJavct.className = 'px-2.5 py-1.5 rounded bg-[var(--bg-shell)] hover:bg-[var(--bg-panel-hover)] text-[var(--text-dim)] border border-[var(--border-rule)] cursor-pointer';
        applyFilter();
      };

      btnJavct.onclick = () => {
        FILTER_SOURCE = 'javct';
        btnJavct.className = 'px-2.5 py-1.5 rounded bg-[var(--accent-cyan)] text-black font-semibold cursor-pointer border-0';
        btnAll.className = 'px-2.5 py-1.5 rounded bg-[var(--bg-shell)] hover:bg-[var(--bg-panel-hover)] text-[var(--text-dim)] border border-[var(--border-rule)] cursor-pointer';
        applyFilter();
      };

      prevBtn.onclick = () => { PAGE--; render(); window.scrollTo({ top: 0, behavior: 'smooth' }); };
      nextBtn.onclick = () => { PAGE++; render(); window.scrollTo({ top: 0, behavior: 'smooth' }); };

      init();
    })();
  </script>
</BaseLayout>
