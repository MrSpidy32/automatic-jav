---
import BaseLayout from '../../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

let stats = {
  sources: { "JAV.guru": 28003, "MissAV": 30443, "OneJAV": 4708, "JavCT": 941, "Models": 1525 },
  timeline: {},
  total_codes: 36654
};

try {
  const statsPath = path.resolve('public/stats.json');
  if (fs.existsSync(statsPath)) {
    stats = JSON.parse(fs.readFileSync(statsPath, 'utf-8'));
  }
} catch (e) {}

const totalIndexed = Object.values(stats.sources).reduce((a, b) => a + b, 0);
---

<BaseLayout title="Ingestion Statistics & Telemetry · JAV.guru" currentPage="stats" activeSource="Telemetry Console" itemCount={`${totalIndexed.toLocaleString()} items`}>
  <div class="space-y-8 font-mono">

    <!-- Title -->
    <div class="border-b border-[var(--border-rule)] pb-4">
      <div class="text-xs text-[var(--accent-cyan)] mb-1">SYSTEM // TELEMETRY</div>
      <h1 class="font-display text-2xl font-bold text-[var(--text-bright)]">Pipeline Ingestion & Growth Statistics</h1>
      <p class="text-xs text-[var(--text-dim)] mt-1">Real-time metrics on repository sizes, stream discovery velocity, and source distribution.</p>
    </div>

    <!-- Source Breakdown Grid -->
    <div>
      <h2 class="text-xs font-bold text-[var(--text-muted)] uppercase tracking-wider mb-3">Repository Distribution</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        {Object.entries(stats.sources).map(([src, count]) => (
          <div class="bg-[var(--bg-panel)] border border-[var(--border-rule)] p-4 rounded-lg">
            <div class="text-[11px] text-[var(--text-muted)]">{src}</div>
            <div class="text-xl sm:text-2xl font-bold text-[var(--text-bright)] mt-1 tabular-nums">
              {Number(count).toLocaleString()}
            </div>
            <div class="text-[10px] text-[var(--text-dim)] mt-1">
              {((Number(count) / totalIndexed) * 100).toFixed(1)}% of total
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Growth Timeline Canvas / Visualization -->
    <div class="bg-[var(--bg-panel)] border border-[var(--border-rule)] p-5 rounded-lg space-y-4">
      <div class="flex items-center justify-between border-b border-[var(--border-rule)] pb-3">
        <div>
          <h3 class="font-bold text-sm text-[var(--text-bright)]">Accession Timeline</h3>
          <span class="text-xs text-[var(--text-dim)]">Daily additions across pipeline snapshot files</span>
        </div>
        <span class="text-xs text-[var(--accent-cyan)]" id="chart-total-days">Computing points...</span>
      </div>

      <div class="relative h-64 w-full flex items-end justify-between pt-6" id="timeline-bars">
        <!-- Injected client-side bar chart -->
      </div>
    </div>

    <!-- Automated Pipeline Status Diagnostics -->
    <div class="bg-[var(--bg-panel)] border border-[var(--border-rule)] p-5 rounded-lg space-y-3 text-xs">
      <div class="font-bold text-sm text-[var(--text-bright)]">Pipeline Diagnostics & Performance Floor</div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-[var(--text-dim)] pt-2">
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <span>Deduplication Efficiency:</span>
            <span class="text-[var(--accent-green)]">91.4% Duplicate Reject Rate</span>
          </div>
          <div class="flex items-center justify-between">
            <span>Stream Coverage Ratio:</span>
            <span class="text-[var(--accent-cyan)]">~70.4% JAV.guru Streams Resolved</span>
          </div>
          <div class="flex items-center justify-between">
            <span>Torrent Rolling Window:</span>
            <span class="text-white">20 Days (OneJAV)</span>
          </div>
        </div>
        <div class="space-y-1.5">
          <div class="flex items-center justify-between">
            <span>Execution Environment:</span>
            <span class="text-white">Docker / Ubuntu Latest</span>
          </div>
          <div class="flex items-center justify-between">
            <span>Automation Trigger:</span>
            <span class="text-white">Daily 10:00 UTC Cron</span>
          </div>
          <div class="flex items-center justify-between">
            <span>Hosting Target:</span>
            <span class="text-[var(--accent-cyan)]">GitHub Pages (Static)</span>
          </div>
        </div>
      </div>
    </div>

  </div>

  <script is:inline>
    (function() {
      const BASE_URL = new URL('../', window.location.href).href;
      const chart = document.getElementById('timeline-bars');
      const chartDays = document.getElementById('chart-total-days');

      async function loadStats() {
        try {
          const res = await fetch(`${BASE_URL}stats.json`);
          const data = await res.json();
          const timeline = data.timeline || {};
          const dates = Object.keys(timeline).sort();
          if (dates.length === 0) return;

          chartDays.textContent = `${dates.length} historical dates recorded`;

          // Take last 30 data points for legible bar chart
          const sliceDates = dates.slice(-30);
          const counts = sliceDates.map(d => timeline[d]);
          const max = Math.max(...counts, 1);

          chart.replaceChildren();
          sliceDates.forEach((d, idx) => {
            const count = timeline[d];
            const heightPct = Math.max(5, (count / max) * 100);

            const col = document.createElement('div');
            col.className = 'flex-1 flex flex-col items-center h-full justify-end group relative cursor-pointer';

            const bar = document.createElement('div');
            bar.className = 'w-full mx-0.5 bg-[var(--border-rule)] group-hover:bg-[var(--accent-cyan)] rounded-t transition-all';
            bar.style.height = `${heightPct}%`;

            const tooltip = document.createElement('div');
            tooltip.className = 'opacity-0 group-hover:opacity-100 absolute bottom-full mb-2 bg-black/90 border border-[var(--border-rule)] text-[10px] text-white p-2 rounded whitespace-nowrap pointer-events-none z-10 shadow-lg';

            const dateHeader = document.createElement('div');
            dateHeader.className = 'font-bold text-[var(--accent-cyan)]';
            dateHeader.textContent = d;

            const countText = document.createElement('div');
            countText.textContent = `${count.toLocaleString()} videos added`;

            tooltip.appendChild(dateHeader);
            tooltip.appendChild(countText);

            col.appendChild(bar);
            col.appendChild(tooltip);
            chart.appendChild(col);
          });
        } catch (e) {
          const err = document.createElement('div');
          err.className = 'w-full text-center text-[var(--text-muted)]';
          err.textContent = 'Could not load historical timeline points.';
          chart.replaceChildren(err);
        }
      }

      loadStats();
    })();
  </script>
</BaseLayout>
